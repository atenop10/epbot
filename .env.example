BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=123456789
# Cloudflare R2 (copy these 4 values from Audiosfm/r2_storage.php in your website backup)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=audiosfm
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# false = everyone can use the bot; true = only users given /grant access
REQUIRE_SUBSCRIPTION=false
CONTACT_TEXT=To subscribe, contact @your_username
DELETE_AFTER_SECONDS=5400
MAX_RANGE=30
# Optional: store NEW episodes in a private Telegram channel instead of R2 (bot must be channel admin with post rights).
# Channel id looks like -1001234567890. Leave empty to keep using R2.
STORAGE_CHANNEL_ID=

# Optional streaming player: R2 episodes are sent as a temporary "Play" link instead of a file.
# STREAM_BASE_URL is the public https address of the player, STREAM_SECRET is any long random string
# (create one with: openssl rand -hex 32). Leave both empty to keep sending files.
STREAM_BASE_URL=
STREAM_SECRET=
STREAM_PORT=8080
STREAM_RATE_KBPS=80
STREAM_MAX_DEVICES=2
STREAM_SESSION_MIN=90

# Optional force-join: users must join these channels before using the bot.
# Public channel: @mychannel   Private channel: -1001234567890|https://t.me/+InviteLink
# Separate several with commas. The bot must be an ADMIN of each channel (so it can check members). Leave empty to turn off.
FORCE_SUB_CHANNELS=

# Optional ad on the streaming player (set the code in the bot with /setad). 280 fits a 300x250 banner, use 60 for 320x50.
STREAM_AD_HEIGHT=280
# Where the ad code is stored (default ad.html in the bot folder). You normally don't need to change this.
# STREAM_AD_FILE=ad.html

# Mini App: audio link only works in the browser that opened the app (default true). Set false only if audio fails in Telegram Web.
# MINIAPP_REQUIRE_COOKIE=true

# Rewarded ads (freemium): everyone can browse and gets free listening every day with no ad; watching an ad gives BONUS time.
# See REWARDED_ADS.md.  Easiest: bash setup-rewarded.sh adsgram <block id>     (or: monetag <zone id> / off)
# Which network shows the bonus ad: adsgram | monetag | off. Leave empty = Adsgram if a block id is set, else Monetag.
AD_PROVIDER=
# Adsgram: your Reward block id (partner.adsgram.ai)
AD_ADSGRAM_BLOCK=
# Adsgram TEST ads for integration checks only. Must be off in production (test views earn nothing).
# AD_ADSGRAM_DEBUG=off
# Monetag: Rewarded Interstitial zone id (also needed for the optional In-App ads below)
AD_REWARD_ZONE=
# Free listening with no ad: minutes per window, and how many hours until the next window. The window starts at the first play.
# AD_FREE_MINUTES=0 = strict mode (an ad is needed for everything). Adsgram does not accept strict mode.
AD_FREE_MINUTES=30
AD_FREE_EVERY_HOURS=24
# Bonus minutes of listening that one ad adds
AD_PASS_MINUTES=60
# Most ads that count per user per 24 hours
AD_MAX_PER_DAY=12
# Ignore "ad finished" reports faster than this (seconds) - stops fake claims
AD_MIN_WATCH_SECONDS=5
# If the ad network has no ad / the SDK is blocked: free minutes given instead, and how often per day (0 = never)
AD_GRACE_MINUTES=5
AD_GRACE_PER_DAY=2
# Optional automatic Monetag In-App Interstitial ads for free users (needs AD_REWARD_ZONE): off | on | frequency,capping,interval,timeout
# "on" = 2 ads per 6 min, 30 s apart, first after 5 s. Off by default.
AD_INAPP=off
# Only change if Monetag gives you a different SDK address
# AD_SDK_URL=https://libtl.com/sdk.js

# Paid passes (Razorpay): ad-free + no time limit. Needs the streaming server (STREAM_BASE_URL). Leave the keys empty to keep it OFF.
# Easiest: bash setup-pay.sh <key_id> <key_secret> <webhook_secret> 15:7,49:30    (see RAZORPAY_FAVORITES.md)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plans as rupees:days, comma separated. Default = Rs 15 for 7 days (weekly) and Rs 49 for 30 days (monthly).
SUB_PLANS=15:7,49:30

# Favorites: people who add a series to favorites get a message when a new episode is added.
# Uploads made within this many seconds of each other are sent as ONE message ("Episodes 5-7 are out").
NOTIFY_DELAY_SECONDS=90
